# --- Clés d'API ---
NEWS_API_KEY=
GNEWS_API_KEY=
CURRENTS_API_KEY=

MISTRAL_API_KEY=

# --- Mot de passe d'accès au site (vide = site ouvert) ---
SITE_PASSWORD=

# --- Réglages Mistral (valeurs par défaut si laissé vide) ---
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TEMPERATURE=0.1

# --- URLs des sources d'articles (la clé d'API est ajoutée automatiquement) ---
DEVTO_API_URL=https://dev.to/api/articles?tag=programming&per_page=15
CURRENTS_API_URL=https://api.currentsapi.services/v1/latest-news?language=en&category=technology
GNEWS_API_URL=https://gnews.io/api/v4/top-headlines?category=technology&lang=en
NEWSAPI_API_URL=https://newsapi.org/v2/top-headlines?category=technology
