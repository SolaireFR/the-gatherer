FROM golang:1.26.4-alpine AS builder

WORKDIR /app

# Driver SQLite en Go pur : aucun compilateur C nécessaire
ENV CGO_ENABLED=0

COPY go.mod go.sum ./
RUN go mod download

# page.html est embarque dans le binaire (//go:embed) : il doit etre present
# a la compilation, mais plus rien n'est a deployer a cote de l'executable.
COPY main.go page.html favicon.svg ./
RUN go build -v -o veille-app main.go

FROM alpine:3.20

WORKDIR /app
COPY --from=builder /app/veille-app ./
RUN mkdir -p /app/data

EXPOSE 8080

CMD ["./veille-app"]
