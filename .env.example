# Copier ce fichier en `.env` (non versionné). L'environnement (Docker, shell) reste prioritaire.
# Seules les variables des packages importés dans back/main.go sont lues.
# Ce fichier ne règle que le démarrage (ports, base, secrets de connexion) : les valeurs modifiables à chaud sont des réglages de la page /admin (cf. RÉGLAGES).
# [OBLIGATOIRE] = l'application refuse de démarrer si la variable est absente ou vide.
# Les variables PUBLIC_* sont copiées dans .gosvelte/generated/env.ts (gosvelte generate / dev ; gosvelte docker lit celles de ce fichier) : n'y mettre aucun secret.

# ############################ APPLICATION ############################
# Nom du projet (public) [OBLIGATOIRE]
PUBLIC_PROJECT_NAME=The Gatherer

# ############################ SEO ####################################
# Lues au build du front (app.html, gosvelte-seo) : relancer gosvelte build après modification.
# Description du site pour les moteurs de recherche et les aperçus de liens (150 caractères environ, sans guillemets)
PUBLIC_PROJECT_DESCRIPTION=Veille quotidienne : news de la veille récupérées chaque nuit par l’IA, favoris.
# Adresse publique du site (ex : https://mon-site.fr) : URL canoniques, og:url, sitemap.xml ; vide = pas de sitemap
PUBLIC_SITE_URL=

# ############################ SERVEUR ################################
# Port du serveur backend (défaut : 3333)
PORT=3333
# Origines autorisées à appeler /api depuis un autre domaine (app mobile : Android https://localhost, iOS capacitor://localhost)
CORS_ORIGINS=https://localhost,capacitor://localhost
# Taille maximale du corps d'une requête /api hors envoi de fichiers, en Mo (défaut : 2)
API_MAX_BODY=2
# Derrière un proxy inverse (nginx, Traefik, Caddy…) : IP ou plages CIDR du ou des proxys, séparées par des virgules
# (ex : 127.0.0.1 ou 10.0.0.0/8) : IP du client = première adresse de X-Forwarded-For hors de ces proxys en partant de la
# droite (limites de connexion par IP, journal, page /admin) ; false = pas de proxy, IP de la connexion (défaut : false).
# true = obsolète : en-tête accepté de tout client (IP falsifiable si le port de l'app est joignable sans le proxy),
# refusé au démarrage avec la page /admin, comme 0.0.0.0/0 ou ::/0 (tout client serait un proxy de confiance).
# Proxy HTTPS : transmettre aussi X-Forwarded-Proto (cookies de session Secure, HSTS)
TRUST_PROXY=false

# ############################ MOBILE (Capacitor) ####################
# URL du serveur appelée par l'app mobile (ex : https://mon-site.fr) ; vide = même origine (web, live-reload gosvelte mobile dev)
PUBLIC_API_URL=
# Identifiant de l'app mobile, domaine inversé sans _ (iOS) (défaut : com.example.myapp)
PUBLIC_APP_ID=com.example.myapp

# ############################ BASE DE DONNÉES ########################
# --- SQLite (github.com/SolaireFR/gosvelte/gosvelte-core/database/sqlite) ---
# Nom de la base de données, fichier <DB_NAME>.db [OBLIGATOIRE]
DB_NAME=app_db
# Dossier du fichier SQLite [OBLIGATOIRE]
SQLITE_PATH=./data

# --- MySQL (github.com/SolaireFR/gosvelte/gosvelte-core/database/mysql) ---
# DB_NAME (ci-dessus) est aussi [OBLIGATOIRE] pour MySQL
# Hôte MySQL [OBLIGATOIRE]
MYSQL_HOST=127.0.0.1
# Port MySQL [OBLIGATOIRE]
MYSQL_PORT=3336
# Utilisateur MySQL [OBLIGATOIRE]
MYSQL_USER=appuser
# Mot de passe MySQL [OBLIGATOIRE]
MYSQL_PASS=apppass

# --- CSV (github.com/SolaireFR/gosvelte/gosvelte-core/database/csv) ---
# Dossier des fichiers CSV, un fichier par table [OBLIGATOIRE]
CSV_PATH=./data/csv

# ############################ AUTHENTIFICATION #######################
# Inscription libre (AUTH_REGISTER) et durée de session (JWT_DURATION) : réglages de la page /admin (cf. RÉGLAGES)

# --- Basic / JWT local (github.com/SolaireFR/gosvelte/gosvelte-core/auth/basic) ---
# Les valeurs d'exemple de JWT_SECRET_KEY et ADMIN_PASSWORD sont publiques : refusées hors « gosvelte dev »
# (« gosvelte new » les remplace par des valeurs aléatoires dans .env)
# Clé de signature JWT, longue et aléatoire (ex. openssl rand -base64 48) [OBLIGATOIRE]
JWT_SECRET_KEY=dev-only-change-me-jwt-secret-key
# Identifiant de l'admin créé au premier démarrage (défaut : admin)
ADMIN_USERNAME=admin
# Email de l'admin créé au premier démarrage (défaut : admin@app.local)
ADMIN_EMAIL=admin@app.local
# Mot de passe de l'admin créé au premier démarrage, 8 à 72 caractères [OBLIGATOIRE]
ADMIN_PASSWORD=admin123

# --- Keycloak (github.com/SolaireFR/gosvelte/gosvelte-core/auth/keycloak) ---
# URL du serveur Keycloak [OBLIGATOIRE]
KEYCLOAK_SERVER=http://localhost:3380
# Realm Keycloak (cf. .gosvelte/services/keycloak-realm.json, importé par gosvelte services up) [OBLIGATOIRE]
KEYCLOAK_REALM=app
# Client de connexion : Direct access grants seul (cf. .gosvelte/services/keycloak-realm.json) [OBLIGATOIRE]
KEYCLOAK_CLIENT_ID=app-client
# Secret du client de connexion [OBLIGATOIRE]
KEYCLOAK_CLIENT_SECRET=app-secret
# Client de gestion des comptes, DISTINCT du client de connexion : Service accounts seul (manage-users, view-users ;
# view-clients : nombre de sessions de la page /admin) [OBLIGATOIRE]
KEYCLOAK_ADMIN_CLIENT_ID=app-admin
# Secret du client de gestion des comptes [OBLIGATOIRE]
KEYCLOAK_ADMIN_CLIENT_SECRET=app-admin-secret

# ############################ FICHIERS ###############################
# Tailles maximales, quota, rôle d'envoi et types acceptés : réglages de la page /admin (cf. RÉGLAGES)

# --- Dossier local (github.com/SolaireFR/gosvelte/gosvelte-core/storage/local) ---
# Dossier des fichiers stockés (défaut : ./data/files)
STORAGE_PATH=./data/files

# --- MinIO (github.com/SolaireFR/gosvelte/gosvelte-core/storage/minio, cf. gosvelte services up) ---
# Adresse de MinIO, hôte:port sans http:// (défaut : localhost:3390)
MINIO_ENDPOINT=localhost:3390
# Identifiant d'accès MinIO (docker : compte root ; en production, un utilisateur dédié limité au bucket) [OBLIGATOIRE]
MINIO_ACCESS_KEY=minioadmin
# Clé secrète MinIO, 8 caractères minimum, À CHANGER en production [OBLIGATOIRE]
MINIO_SECRET_KEY=minioadmin-dev-secret
# Bucket des fichiers, créé au démarrage s'il manque (défaut : app-files)
MINIO_BUCKET=app-files
# true = connexion HTTPS à MinIO (défaut : false)
MINIO_USE_SSL=false

# ############################ GÉOGRAPHIE #############################
# --- Villes et pays (github.com/SolaireFR/gosvelte/gosvelte-core/geo) ---
# Fichier cities1000.txt de GeoNames à la place des villes embarquées dans le binaire (vide = embarquées, recommandé)
GEO_CITIES_FILE=
# Codes postaux GeoNames (recherche par code postal) : allCountries.zip (monde, ~20 Mo, lu sans extraction) ou <PAYS>.zip
# (ex. ./data/geonames/postal/FR.zip : France seule), téléchargé s'il manque ; off = sans codes postaux
GEO_POSTAL_FILE=./data/geonames/postal/allCountries.zip

# ############################ ADMINISTRATION #########################
# --- Page /admin (github.com/SolaireFR/gosvelte/gosvelte-core/admin) : rôle admin seulement, 404 pour les autres ---
# IP ou plages CIDR autorisées à ouvrir /admin, séparées par des virgules (ex : 203.0.113.7,192.168.1.0/24,2001:db8::/32) ;
# vide = toutes. Recommandé en production : hors de la liste, réponse identique à une route inconnue, sans appel à la base
# ni à Keycloak. Derrière un proxy inverse : TRUST_PROXY = IP du proxy (sinon l'IP vue est celle du proxy).
# Sous « gosvelte dev », tout passe par le proxy de Vite : IP vue = 127.0.0.1 ou ::1 (à autoriser pour tester un filtre).
ADMIN_ALLOWED_IPS=
# Durée du mode administrateur après saisie du mot de passe, en minutes, 0 à 1440 (défaut : 15 ; 0 = jamais redemandé, déconseillé) ;
# prolongeable une fois de 5 minutes (dialogue 30 s avant la fin)
ADMIN_SUDO_MINUTES=15

# ############################ RÉGLAGES ###############################
# --- Réglages de la page /admin (github.com/SolaireFR/gosvelte/gosvelte-core/settings) : chiffrés en base, effet immédiat ---
# Clé de chiffrement des réglages, 32 caractères minimum, longue et aléatoire (ex. openssl rand -base64 48).
# Valeur d'exemple publique : refusée hors « gosvelte dev » (« gosvelte new » en génère une aléatoire dans .env).
# Vide = réglages en lecture seule (environnement ou défauts) tant que la table est vide ; obligatoire dès que la table
# gosvelte_settings contient des lignes (sinon démarrage refusé : réglages enregistrés jamais ignorés).
# Perdue = réglages enregistrés illisibles, démarrage refusé (la sauvegarder avec la base ; repartir de zéro : vider la
# table gosvelte_settings).
# Changer de clé : l'ancienne dans SETTINGS_SECRET_KEY_OLD le temps d'un démarrage (réglages rechiffrés), puis la retirer.
# Chiffre aussi les clés d'API saisies dans /admin > Clés d'API (package apis).
SETTINGS_SECRET_KEY=dev-only-change-me-settings-secret-key
# Clés d'une API externe déclarée par apis.Register("nom", …), séparées par des virgules, essayées dans l'ordre : lues
# seulement tant qu'aucune clé n'est enregistrée depuis /admin > Clés d'API (ex. API_METEO_KEYS=cle1,cle2)
# API_<NOM>_KEYS=
# Clé Mistral des news (API externe « mistral », back/news/fetch.go)
API_MISTRAL_KEYS=
# Réglages du moteur (défaut) ; ancienne variable d'environnement du même nom encore lue tant qu'aucune valeur n'est
# enregistrée depuis /admin (obsolète : régler depuis la page /admin ; valeur inutilisable, ex. pas un nombre entier ou
# hors des limites techniques affichées dans /admin = démarrage refusé, avec la raison et la correction) :
#   AUTH_REGISTER (true)          inscription libre (page /register) ; false = comptes créés par l'admin ou dans Keycloak
#   JWT_DURATION (24)             durée de validité d'une session, en heures (auth basic)
#   AUTH_INACTIVE_MONTHS (0)      nouveau (RGPD) : comptes supprimés avec leurs données après N mois sans connexion
#                                 (auth basic, 0 = jamais, admins jamais supprimés) ; cf. RGPD.md
#   ADMIN_AUDIT_RETENTION_MONTHS (12) nouveau (RGPD) : conservation du journal d'administration, en mois (CNIL : 6 à 12)
#   STORAGE_MAX_IMAGE (1)         poids maximal d'une image (image/*) : 200Ko, 1.5Mo, 2Go (nombre seul = Mo)
#   STORAGE_MAX_DOCUMENT (2)      poids maximal d'un document (ni image ni vidéo), même format
#   STORAGE_MAX_VIDEO (10)        poids maximal d'une vidéo (video/*), même format
#   STORAGE_USER_QUOTA (50)       espace total par utilisateur, même format (0 = illimité)
#   STORAGE_MAX_IMAGE_SIDE (0)    nouveau : plus grand côté d'une image, en pixels (0 = libre)
#   STORAGE_COMPRESS_IMAGES (false) nouveau : images trop lourdes ou trop grandes réduites par le navigateur avant
#                                 l'envoi (erreur de taille si elles ne tiennent toujours pas)
#   STORAGE_UPLOAD_ROLE (vide)    rôle requis pour envoyer ou remplacer des fichiers (vide = toute personne connectée ;
#                                 admin passe partout)
#   STORAGE_ALLOWED_TYPES (vide)  nouveau : types acceptés, ex. image/*,application/pdf (vide = tous) ; le type déclaré
#                                 ET le type détecté dans le contenu doivent y figurer : docx / xlsx = application/zip ;
#                                 csv, json, txt = text/plain ; svg = text/xml ou text/plain ; doc / xls, HEIC / AVIF, MOV
#                                 et binaire inconnu = application/octet-stream (le lister = tout binaire non reconnu accepté)
